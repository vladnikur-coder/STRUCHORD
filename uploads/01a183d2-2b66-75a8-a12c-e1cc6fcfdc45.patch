+/* Предпрослушивание: плотная фраза не расходует лимит на будущие ноты. */
+const assert=require('assert'),puppeteer=require('puppeteer');const wait=ms=>new Promise(r=>setTimeout(r,ms));
+(async()=>{const b=await puppeteer.launch({executablePath:process.env.PUPPETEER_EXECUTABLE_PATH||'/tmp/chromium',args:['--no-sandbox']});try{
+ const p=await b.newPage(),errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('dialog',d=>d.accept());await p.setViewport({width:1440,height:900});await p.evaluateOnNewDocument(()=>localStorage.setItem('struchord-default-instrument','keys'));await p.goto(process.env.STRUCHORD_URL||'http://127.0.0.1:8015/STRUCHORD.html');
+ await p.evaluate(async()=>{startNewSongFromHome();addSection('Chorus');let s=sections[0],q=s.squares[0],e=q.events[0];e.chord='C';let cell=StruChordTracks.cellKey(s,q,0);StruChordTracks.setExactNotes(1,cell,'C',[48,60,64,67]);let ctx=getAudioContext();await ctx.resume();window.__preview={ctx,s,cell,cfg:{type:'keys-block',subdivision:2,steps:Array(16).fill('H')}};});
+ const start=()=>p.evaluate(()=>{let x=window.__preview;window.__stop=StruChordAudio.previewPattern('C',x.ctx,1,'C',x.cfg,{scope:'section',span:8,bpm:300,ts:'4/4',sec:x.s,cell:x.cell});return StruChordAudio.stats()});
+ await p.evaluate(()=>{StruChordAudio.reset();window.__osc=[];let original=OscillatorNode.prototype.start;OscillatorNode.prototype.start=function(t){if(window.__osc)window.__osc.push({t,f:this.frequency.value});return original.call(this,t)}});const early=await start();assert(early.liveVoices<320,'будущие ноты не занимают весь лимит');await wait(1950);let after=await p.evaluate(()=>StruChordAudio.stats());assert.equal(after.notes,64,'все 16 ударов по 4 ноты запланированы');assert.equal(after.capped,0,'нет пропущенных нот или призвуков');const osc=await p.evaluate(()=>window.__osc);assert.equal(osc.length,384);const fundamentals=osc.filter((_,i)=>i%6===0);assert.deepStrictEqual(fundamentals.map(v=>Math.round(69+12*Math.log2(v.f/440))),Array.from({length:16},()=>[48,60,64,67]).flat(),'высоты четырёх нот каждого удара');fundamentals.forEach((v,i)=>assert(Math.abs(v.t-fundamentals[0].t-Math.floor(i/4)*.1)<.025,'план времени не отстаёт от сетки'));await p.evaluate(()=>{delete window.__osc});await wait(450);assert.equal((await p.evaluate(()=>StruChordAudio.stats())).liveVoices,0,'источники освобождаются');

+  assert(d.key.height>=100*scale/100-.5,`${label}: слишком короткие клавиши ${d.key.height}`);assert(d.rect.top>=d.bar.bottom-1 && d.svg.bottom<=d.rect.bottom-1,`${label}: закрепление и видимость`);assert.equal(d.overflow,'visible');
+  if(d.rect.bottom>h/4+1)assert(d.key.height<=100*scale/100+1,`${label}: четверть превышена не из-за минимума клавиш`);

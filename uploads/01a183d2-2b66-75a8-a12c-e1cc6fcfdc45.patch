+(async()=>{const b=await puppeteer.launch({executablePath:process.env.PUPPETEER_EXECUTABLE_PATH||'/tmp/chromium',args:['--no-sandbox']});try{let p=await b.newPage();await p.goto(process.env.STRUCHORD_URL||'http://127.0.0.1:8035/STRUCHORD.html');let r=await p.evaluate(async()=>{let c=getAudioContext(),out={};for(let m of ['acoustic','rhodes','organ','pad']){await StruChordAudio.preloadTimbre(c,m);const unique=new Map();for(let midi=21;midi<=108;midi++){let a=StruChordSampleBank.nearest(m,midi);unique.set(a.midi,a)};let loops=0,maxJump=0,energy=Infinity;for(let a of unique.values()){let x=a.buffer.getChannelData(0),sum=0;for(let i=0;i<x.length;i+=512)sum+=x[i]*x[i];energy=Math.min(energy,Math.sqrt(sum/Math.ceil(x.length/512)));if(a.loopEnd){loops++;let lo=Math.floor(a.loopStart*a.buffer.sampleRate),hi=Math.floor(a.loopEnd*a.buffer.sampleRate);maxJump=Math.max(maxJump,Math.abs(x[hi-1]-x[lo]));}}out[m]={count:unique.size,energy,maxJump,loops};}return out});for(let mode of Object.keys(r)){assert(r[mode].count>=7);assert(r[mode].energy>0.0001,mode+' non-silent');if(mode!=='acoustic'){assert.equal(r[mode].loops,r[mode].count);assert(r[mode].maxJump<.05,mode+' loop-boundary continuity '+r[mode].maxJump);}}console.log('Sample waveforms: non-silent, numerical loop continuity — OK; this does not replace listening',r)}finally{await b.close()}})().catch(e=>{console.error(e);process.exit(1)});
